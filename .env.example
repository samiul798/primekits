# PostgreSQL connection for the Primkits database
# Replace YOUR_POSTGRES_PASSWORD with the password you set when installing PostgreSQL.
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@127.0.0.1:5432/Primkits

# Used by the Next.js app for signing admin sessions.
JWT_SECRET=change-this-to-a-long-random-secret

# Required to run POST /api/seed in production. Send it as x-seed-secret.
SEED_SECRET=change-this-to-a-separate-long-random-secret
# Used only when the first admin is created by production seeding.
SEED_ADMIN_PASSWORD=choose-a-strong-initial-admin-password

# Public production HTTPS URL. Required by bKash/Nagad as their callback base.
# Example: https://shop.example.com (never use localhost for live payments)
NEXT_PUBLIC_APP_URL=https://your-domain.example

# bKash Tokenized Checkout. Obtain these from the bKash merchant portal.
# Sandbox base URL: https://tokenized.sandbox.bka.sh/v1.2.0-beta
# Production base URL is provided with your live merchant credentials.
# BKASH_BASE_URL=
# BKASH_USERNAME=
# BKASH_PASSWORD=
# BKASH_APP_KEY=
# BKASH_APP_SECRET=

# Nagad merchant credentials and its signed PGW initialisation endpoint are
# merchant-specific. The HTTPS return/callback URL is shown below in README.
# NAGAD_INITIALIZE_URL=
# NAGAD_MERCHANT_ID=
# NAGAD_MERCHANT_PRIVATE_KEY=

# Required for an automated scheduler that POSTs to
# /api/admin/reservations/cleanup with x-reservation-cleanup-secret.
RESERVATION_CLEANUP_SECRET=change-this-to-a-separate-long-random-secret

# Store contact. Enter a real Bangladeshi WhatsApp number in Admin → Settings
# (01XXXXXXXXX, +8801XXXXXXXXX, or 8801XXXXXXXXX). It is never hardcoded.
# WHATSAPP_NUMBER=8801XXXXXXXXX

# Meta WhatsApp Business Cloud API (optional, enables automatic confirmations).
# Create an approved template containing exactly three body variables:
# {{1}} customer name, {{2}} order number, {{3}} total. The message should ask
# the customer to reply YES / CONFIRM to confirm the order.
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=use-a-long-random-secret
# WHATSAPP_TEMPLATE_NAME=primekits_order_confirmation
# WHATSAPP_TEMPLATE_LANGUAGE=en_US
# WHATSAPP_GRAPH_API_VERSION=v23.0

# Courier integrations are intentionally disabled until an official adapter and
# credentials for the selected courier are configured server-side.
# COURIER_API_KEY=
# COURIER_API_SECRET=
# COURIER_MERCHANT_ID=
