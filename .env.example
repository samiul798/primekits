# PostgreSQL connection for the Primkits database
# Replace YOUR_POSTGRES_PASSWORD with the password you set when installing PostgreSQL.
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@127.0.0.1:5432/Primkits

# Used by the Next.js app for signing admin sessions.
JWT_SECRET=change-this-to-a-long-random-secret

# Required to run POST /api/seed in production. Send it as x-seed-secret.
SEED_SECRET=change-this-to-a-separate-long-random-secret
# Used only when the first admin is created by production seeding.
SEED_ADMIN_PASSWORD=choose-a-strong-initial-admin-password

# Required for an automated scheduler that POSTs to
# /api/admin/reservations/cleanup with x-reservation-cleanup-secret.
RESERVATION_CLEANUP_SECRET=change-this-to-a-separate-long-random-secret

# Store contact. Enter a real Bangladeshi WhatsApp number in Admin → Settings
# (01XXXXXXXXX, +8801XXXXXXXXX, or 8801XXXXXXXXX). It is never hardcoded.
# WHATSAPP_NUMBER=8801XXXXXXXXX

# Courier integrations are intentionally disabled until an official adapter and
# credentials for the selected courier are configured server-side.
# COURIER_API_KEY=
# COURIER_API_SECRET=
# COURIER_MERCHANT_ID=
